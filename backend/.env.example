# Optional. Leave blank to run fully offline on the local rule-based gloss
# engine (app/services/local_gloss.py). When set, convert_to_gloss_smart()
# uses this as a fallback for phrases the local engine has low confidence on.
GROQ_API_KEY=

# Identifies this install in the sessions/quick_phrases tables.
KIOSK_ID=kiosk_dev_01
KIOSK_LOCATION=Development

CORS_ALLOWED_ORIGINS=http://localhost:5173,http://192.168.1.50:5173

# Pipeline B. Leave blank until a trained recognizer model exists —
# app/services/recognition.py runs in an explicit stub mode without it.
RECOGNIZER_MODEL_PATH=
